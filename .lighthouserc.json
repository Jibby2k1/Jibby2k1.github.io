{
  "ci": {
    "collect": {
      "staticDistDir": ".",
      "url": [
        "http://localhost/index.html",
        "http://localhost/research.html",
        "http://localhost/photography.html",
        "http://localhost/cv.html",
        "http://localhost/about.html",
        "http://localhost/contact.html",
        "http://localhost/blog.html",
        "http://localhost/research-physics.html",
        "http://localhost/projects/cfd-surrogate-modeling.html",
        "http://localhost/notes/preregistering-against-yourself.html"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:seo": ["warn", { "minScore": 1 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }]
          }
        },
        {
          "matchingUrlPattern": "^.*/(index|research|photography|cv)\\.html$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.8, "aggregationMethod": "median-run" }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }]
          }
        }
      ]
    }
  }
}
